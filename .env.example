# Screen capture ROI (pixels). Leave unset to use full primary monitor.
# CAPTURE_ROI_LEFT=100
# CAPTURE_ROI_TOP=200
# CAPTURE_ROI_WIDTH=1400
# CAPTURE_ROI_HEIGHT=700

# Kelly fraction used when we size stakes ourselves
KELLY_FRACTION=0.33

# Bankroll in dollars for Kelly sizing (Decision stage)
BANKROLL=2000

# Decision rules
MIN_EV_PERCENT=0
ONE_BET_PER_GAME=true
MAX_OPEN_BETS=20
# MARKET_ALLOWLIST=under,over
PORTFOLIO_DB=data/portfolio.db

# =============================================================================
# NOVIG PAPER CREDENTIALS
# =============================================================================
# (A) API KEY ID  -> paste below after the =
#     Short id from Novig Paper: Profile -> Settings -> Novig API
NOVIG_KEY_ID=PASTE_YOUR_API_KEY_ID_HERE

# (B) PRIVATE KEY -> do NOT paste here
#     Put the full PEM contents in: secrets/novig-paper.pem
NOVIG_HOST=https://api.paper.novig.com
NOVIG_PEM_PATH=secrets/novig-paper.pem

# Trading subaccount (created by: python -m moneyscheme.app.novig_bootstrap)
NOVIG_TRADING_KEY_ID=
NOVIG_TRADING_PEM_PATH=secrets/novig-trading.pem
